<?xml version="1.0" encoding="utf-8"?>
<!--
  CI 专用 NuGet 配置。
  
  仓库根目录的 nuget.config 里有一个**本机专用**的 fallbackPackageFolders
  （D:\AS\ASSV\_fallback，用来绕开作者机器上 SDK 10 / NuGet 7.9 的
  "Value cannot be null (Parameter 'path1')" 问题），这个路径在 GitHub
  runner 上不存在，所以 CI 改用这份干净配置。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
