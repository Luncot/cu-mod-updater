<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 机器级 fallback (E:/VST/NuGetPackages) 不可访问。
       SDK 10.0.401 / NuGet 7.9 对空 fallback 列表会序列化出 null 导致 assets 损坏，
       所以这里显式指向一个真实存在的空目录，而不是 <clear />。 -->
  <fallbackPackageFolders>
    <add key="LocalFallback" value="D:\AS\ASSV\_fallback" />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
